{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bash_orchard",
      "camelcase": "BashOrchard",
      "title": "Bash",
      "scope": "source.bash",
      "file-types": [
        "bash",
        ".bashrc",
        "ebuild",
        "sh",
        "eclass",
        ".bash_profile"
      ],
      "injection-regex": "^bash_orchard$",
      "class-name": "TreeSitterBashOrchard"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for Bash files",
    "authors": [
      {
        "name": "Max Brunsfeld",
        "email": "maxbrunsfeld@gmail.com"
      },
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://codeberg.org/grammar-orchard/tree-sitter-bash-orchard",
      "upstream": "https://github.com/tree-sitter/tree-sitter-bash",
      "github_mirror": "https://github.com/grammar-orchard/tree-sitter-bash-orchard" 
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
